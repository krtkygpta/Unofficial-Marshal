<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="28dp"
        android:height="38dp"
        android:gravity="start|bottom"
        android:left="2dp"
        android:bottom="2dp"
        android:drawable="@drawable/motif_earbud_left" />
    <item
        android:width="40dp"
        android:height="30dp"
        android:gravity="center|bottom"
        android:bottom="6dp"
        android:drawable="@drawable/motif_case" />
    <item
        android:width="28dp"
        android:height="38dp"
        android:gravity="end|bottom"
        android:right="2dp"
        android:bottom="2dp"
        android:drawable="@drawable/motif_earbud_right" />
</layer-list>
