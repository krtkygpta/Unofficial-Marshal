<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_shell">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/widget_panel">
        <ImageView
            android:id="@+id/widget_earbuds_art"
            android:layout_width="76dp"
            android:layout_height="58dp"
            android:src="@drawable/widget_earbuds_art"
            android:contentDescription="Earbuds" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MARSHALL" android:textColor="#AEB0BD" android:textSize="9sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical"><TextView android:layout_width="14dp" android:layout_height="wrap_content" android:text="L" android:textColor="#F3F3F7" android:textSize="12sp" android:textStyle="bold" /><ProgressBar android:id="@+id/widget_left_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:progressTint="#F3F3F7" android:progressBackgroundTint="#555765" /><TextView android:id="@+id/widget_left_value" android:layout_width="31dp" android:layout_height="wrap_content" android:gravity="right" android:text="—" android:textColor="#F3F3F7" android:textSize="10sp" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical"><TextView android:layout_width="14dp" android:layout_height="wrap_content" android:text="R" android:textColor="#F3F3F7" android:textSize="12sp" android:textStyle="bold" /><ProgressBar android:id="@+id/widget_right_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:progressTint="#F3F3F7" android:progressBackgroundTint="#555765" /><TextView android:id="@+id/widget_right_value" android:layout_width="31dp" android:layout_height="wrap_content" android:gravity="right" android:text="—" android:textColor="#F3F3F7" android:textSize="10sp" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical"><TextView android:layout_width="14dp" android:layout_height="wrap_content" android:text="C" android:textColor="#F3F3F7" android:textSize="12sp" android:textStyle="bold" /><ProgressBar android:id="@+id/widget_case_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:progressTint="#F3F3F7" android:progressBackgroundTint="#555765" /><TextView android:id="@+id/widget_case_value" android:layout_width="31dp" android:layout_height="wrap_content" android:gravity="right" android:text="—" android:textColor="#F3F3F7" android:textSize="10sp" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="7dp" android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/widget_anc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="@drawable/widget_panel">
        <ImageView android:id="@+id/widget_anc_icon" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_noise_control_on" android:tint="#F3F3F7" android:contentDescription="Toggle noise control" />
        <TextView android:id="@+id/widget_anc_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Noise control off" android:textColor="#F3F3F7" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
